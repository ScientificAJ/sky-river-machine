{
  "name": "sky-river-machine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:chromium": "node scripts/build-browser.mjs chromium",
    "build:firefox": "node scripts/build-browser.mjs firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "node scripts/audit-build.mjs",
    "evaluate:model": "node scripts/evaluate-model.mjs",
    "check": "npm run typecheck && npm test && npm run build:chromium && npm run build:firefox && npm run audit"
  },
  "dependencies": {
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
